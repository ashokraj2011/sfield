{
  "name": "sfield-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Singularity Field — embeddable, vendor-neutral agent harness (spec v0.13)",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "test": "pnpm run build && node --test --test-concurrency=4 \"packages/*/dist/**/*.test.js\"",
    "test:core": "pnpm run build && node --test \"packages/core/dist/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.6.3"
  }
}
